{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spotlock-camera-lp",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "spotlock.shinp-studio.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
